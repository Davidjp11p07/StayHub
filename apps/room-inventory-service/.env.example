# Room Inventory Service (Sprint 4). Local, non-secret example values only.
# Secrets accept a *_FILE variant (Docker secret); the file wins over the plain variable.
NODE_ENV=development
INVENTORY_PORT=3008

# PostgreSQL 16 exclusive to Inventory (inventory_db). Never point to another service database.
INVENTORY_DATABASE_URL=postgresql://stayhub_inventory:CHANGE_ME@inventory-db:5432/inventory_db?schema=public
# INVENTORY_DATABASE_URL_FILE=/run/secrets/inventory_database_url

# Inbound delegated JWT issued by API Gateway (RS256). Map of kid -> SPKI PEM.
INVENTORY_JWT_PUBLIC_KEYS_JSON={"gateway-dev-2026-01":"-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----"}
# INVENTORY_JWT_PUBLIC_KEYS_JSON_FILE=/run/secrets/inventory_jwt_public_keys
INVENTORY_JWT_ISSUER=stayhub-dev-gateway
INVENTORY_JWT_AUDIENCE=stayhub-room-inventory-service
INVENTORY_JWT_SCOPE=inventory:manage

# Accommodations internal contract GET /internal/v1/rooms/{roomId}/inventory-context.
INVENTORY_ACCOMMODATIONS_URL=http://accommodations-service:3003
INVENTORY_ACCOMMODATIONS_TIMEOUT_MS=2000
INVENTORY_ACCOMMODATIONS_CIRCUIT_FAILURE_THRESHOLD=5
INVENTORY_ACCOMMODATIONS_CIRCUIT_RESET_MS=30000

# Outbound service JWT (Inventory -> Accommodations), signed per call with Inventory's own key.
INVENTORY_SERVICE_PRIVATE_KEY_FILE=/run/secrets/inventory_service_private_key
INVENTORY_SERVICE_JWT_KID=room-inventory-accommodations-2026-01
INVENTORY_SERVICE_JWT_ISSUER=stayhub-room-inventory-service
INVENTORY_ACCOMMODATIONS_AUDIENCE=stayhub-accommodations-service
INVENTORY_ACCOMMODATIONS_SCOPE=accommodations:inventory-context
INVENTORY_SERVICE_TOKEN_TTL_SECONDS=60

# Domain limits (cannot exceed the contract: 200 items, 1 000 000 units).
INVENTORY_MAX_ITEMS_PER_ROOM=200
INVENTORY_MAX_QUANTITY=1000000

INVENTORY_SHUTDOWN_GRACE_MS=10000
INVENTORY_LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
